exports[`CoreStack スナップショット 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "CoreNetwork": {
      "Properties": {
        "Description": "Service Insertion verification core network",
        "GlobalNetworkId": {
          "Fn::GetAtt": [
            "GlobalNetwork",
            "Id",
          ],
        },
        "PolicyDocument": {
          "attachment-policies": [
            {
              "action": {
                "association-method": "constant",
                "segment": "workload",
              },
              "condition-logic": "or",
              "conditions": [
                {
                  "key": "cloudwan-seg",
                  "operator": "equals",
                  "type": "tag-value",
                  "value": "workload",
                },
              ],
              "description": "attach workload segment by tag",
              "rule-number": 100,
            },
            {
              "action": {
                "add-to-network-function-group": "inspection",
              },
              "condition-logic": "or",
              "conditions": [
                {
                  "key": "cloudwan-nfg",
                  "operator": "equals",
                  "type": "tag-value",
                  "value": "inspection",
                },
              ],
              "description": "add to inspection NFG by tag",
              "rule-number": 200,
            },
          ],
          "core-network-configuration": {
            "asn-ranges": [
              "64512-64555",
            ],
            "edge-locations": [
              {
                "asn": 64512,
                "location": "us-east-1",
              },
              {
                "asn": 64513,
                "location": "us-west-2",
              },
              {
                "asn": 64514,
                "location": "ap-northeast-1",
              },
              {
                "asn": 64515,
                "location": "ap-northeast-3",
              },
              {
                "asn": 64516,
                "location": "ap-southeast-1",
              },
            ],
          },
          "network-function-groups": [
            {
              "name": "inspection",
              "require-attachment-acceptance": false,
            },
          ],
          "segment-actions": [
            {
              "action": "send-to",
              "segment": "workload",
              "via": {
                "network-function-groups": [
                  "inspection",
                ],
              },
            },
            {
              "action": "send-via",
              "mode": "single-hop",
              "segment": "workload",
              "via": {
                "network-function-groups": [
                  "inspection",
                ],
              },
              "when-sent-to": {
                "segments": [
                  "workload",
                ],
              },
            },
          ],
          "segments": [
            {
              "edge-locations": [
                "us-east-1",
                "us-west-2",
                "ap-northeast-1",
                "ap-northeast-3",
                "ap-southeast-1",
              ],
              "isolate-attachments": false,
              "name": "workload",
              "require-attachment-acceptance": false,
            },
          ],
          "version": "2025.11",
        },
      },
      "Type": "AWS::NetworkManager::CoreNetwork",
    },
    "GlobalNetwork": {
      "Properties": {
        "Description": "Service Insertion verification global network",
      },
      "Type": "AWS::NetworkManager::GlobalNetwork",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;

